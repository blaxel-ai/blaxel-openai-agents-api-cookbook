# Application key with Agents read/write and Responses write permissions.
OPENAI_API_KEY=
# A distinct environment key from the Agents dashboard, same org/project/owner.
OPENAI_EXECUTOR_API_KEY=
# Either export both values below, or use `bl login` for local runs.
BL_WORKSPACE=
BL_API_KEY=
# Optional overrides. Agent Drive requires us-was-1.
BL_REGION=us-was-1
BL_AGENT_DRIVE_MODE=auto
# BL_AGENT_DRIVE_NAME=
OPENAI_MODEL=gpt-5.6-sol
CODEX_VERSION=alpha
# Optional webhook deployment; preserve the prefix across deploy and reconnect.
# OPENAI_WEBHOOK_RESOURCE_PREFIX=
# OPENAI_AGENT_ID=
# OPENAI_WEBHOOK_SECRET=
# OPENAI_WEBHOOK_ID=
# WORKER_TTL=2h
# CONTROLLER_TTL=24h
